generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String           @id @default(uuid())
  clerkUserId   String           @unique
  email         String           @unique
  name          String?
  imageUrl      String?
  userBudget    UserBudget[]
  balance       Decimal          @default(0) @db.Decimal(10, 2)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  dailyExpense  DailyExpense[]
  monthExpense  MonthlyExpense[]
  monthIncome   MonthlyIncome[]
  transactions  Transaction[]
  spendingInsights SpendingInsight[]
  monthlyReviews   MonthlyReview[]
  monthlyNarratives  MonthlyNarrative[]

  @@map("users")
}

model UserBudget {
  id              String           @id @default(uuid())
  amount          Decimal          @db.Decimal(10, 2)
  month           DateTime
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryBudgets CategoryBudget[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  warningDismissed Boolean          @default(false)

  @@unique([userId, month])
  @@index([userId])
  @@map("userBudgets")
}

model CategoryBudget {
  id           String     @id @default(uuid())
  category     String
  amount       Decimal    @db.Decimal(10, 2)
  userBudgetId String
  userBudget   UserBudget @relation(fields: [userBudgetId], references: [id], onDelete: Cascade)

  @@unique([userBudgetId, category])
  @@index([userBudgetId])
  @@map("categoryBudgets")
}

model DailyExpense {
  id           String             @id @default(uuid())
  date         DateTime
  total        Decimal            @db.Decimal(10, 2)
  userId       String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  expenseItems DailyExpenseItem[]
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("dailyExpenses")
}

model DailyExpenseItem {
  id           String       @id @default(uuid())
  category     String
  amount       Decimal      @db.Decimal(10, 2)
  dailyId      String
  dailyExpense DailyExpense @relation(fields: [dailyId], references: [id], onDelete: Cascade)

  @@unique([dailyId, category])
  @@index([dailyId])
  @@map("dailyExpenseItems")
}

model MonthlyExpense {
  id           String               @id @default(uuid())
  month        DateTime
  total        Decimal              @db.Decimal(10, 2)
  userId       String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  expenseItems MonthlyExpenseItem[]
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId])
  @@map("monthlyExpenses")
}

model MonthlyExpenseItem {
  id             String         @id @default(uuid())
  category       String
  amount         Decimal        @db.Decimal(10, 2)
  monthId        String
  monthlyExpense MonthlyExpense @relation(fields: [monthId], references: [id], onDelete: Cascade)

  @@unique([monthId, category])
  @@index([monthId])
  @@map("monthlyExpenseItems")
}

model MonthlyIncome {
  id           String              @id @default(uuid())
  month        DateTime
  total        Decimal             @db.Decimal(10, 2)
  userId       String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  incomeItems  MonthlyIncomeItem[]
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId])
  @@map("monthlyIncomes")
}

model MonthlyIncomeItem {
  id            String        @id @default(uuid())
  category      String
  amount        Decimal       @db.Decimal(10, 2)
  monthId       String
  monthlyIncome MonthlyIncome @relation(fields: [monthId], references: [id], onDelete: Cascade)

  @@unique([monthId, category])
  @@index([monthId])
  @@map("monthlyIncomeItems")
}


model Transaction {
  id                String             @id @default(uuid())
  type              TransactionType
  amount            Decimal            @db.Decimal(10, 2)
  description       String?
  date              DateTime
  category          String
  receiptUrl        String?
  isRecurring       Boolean
  recurringInterval RecurringInterval?
  nextRecurringDate DateTime?
  lastProcessed     DateTime?
  status            TransactionStatus  @default(COMPLETED)
  userId            String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("transactions")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum RecurringInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
}

model SpendingInsight {
  id        String   @id @default(uuid())
  userId    String
  type      String   // "budget_exceeded" | "burn_rate_alert" | "trend_shift" | "end_of_month_prediction" | "anomaly" | "weekend_ratio"
  title     String
  message   String   @db.Text
  month     DateTime // Truncated to 1st of month for grouping (e.g. 2026-06-01)
  data      Json?    // Optional structured payload for frontend charts (e.g. { daysRatio: 0.4, budgetRatio: 0.7 })
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([userId, month])
  @@map("spendingInsights")
}
model MonthlyReview {
  id                String   @id @default(uuid())
  userId            String
  month             DateTime // Truncated to 1st of month (e.g. 2026-06-01)
  // ── Core Financial Metrics (designated columns) ──
  totalIncome       Decimal  @db.Decimal(12, 2)
  totalExpense      Decimal  @db.Decimal(12, 2)
  netSavings        Decimal  @db.Decimal(12, 2)
  savingsRate       Decimal  @db.Decimal(5, 2)  // Percentage: (netSavings / totalIncome) * 100
  // ── Structured Breakdowns ──
  categoryBreakdown Json     // Array of CategoryBreakdownItem (see JSON schema below)
  recurringExpenses Json     // Array of { description, amount, category, interval }
  budgetStatus      Json     // { totalBudget, totalSpent, exceeded, difference, categoryBudgets: [...] }
  // ── AI Generated Content ──
  summary           String   @db.Text // Gemini-generated executive summary paragraph
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, month])
  @@index([userId])
  @@map("monthlyReviews")
}

model MonthlyNarrative {
  id        String   @id @default(uuid())
  userId    String
  month     DateTime
  content   String   // Dense narrative description of the month's finances
  embedding Unsupported("vector(768)")? // 768 dimensions for Gemini text-embedding-004
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, month])
  @@map("monthlyNarratives")
}