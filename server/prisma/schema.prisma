generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String           @id @default(uuid())
  clerkUserId   String           @unique
  email         String           @unique
  name          String?
  imageUrl      String?
  dailyBudget   Decimal?         @db.Decimal(10, 2)
  monthlyBudget Decimal?         @db.Decimal(10, 2)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  dailyExpense  DailyExpense[]
  monthExpense  MonthlyExpense[]
  transactions  Transaction[]

  @@map("users")
}

model DailyExpense {
  id           String             @id @default(uuid())
  date         DateTime
  total        Decimal            @db.Decimal(10, 2)
  userId       String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  expenseItems DailyExpenseItem[]
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("dailyExpenses")
}

model DailyExpenseItem {
  id           String       @id @default(uuid())
  category     String
  amount       Decimal      @db.Decimal(10, 2)
  dailyId      String
  dailyExpense DailyExpense @relation(fields: [dailyId], references: [id], onDelete: Cascade)

  @@unique([dailyId, category])
  @@index([dailyId])
  @@map("dailyExpenseItems")
}

model MonthlyExpense {
  id           String               @id @default(uuid())
  month        DateTime
  total        Decimal              @db.Decimal(10, 2)
  userId       String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  expenseItems MonthlyExpenseItem[]
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId])
  @@map("monthlyExpenses")
}

model MonthlyExpenseItem {
  id             String         @id @default(uuid())
  category       String
  amount         Decimal        @db.Decimal(10, 2)
  monthId        String
  monthlyExpense MonthlyExpense @relation(fields: [monthId], references: [id], onDelete: Cascade)

  @@unique([monthId, category])
  @@index([monthId])
  @@map("monthlyExpenseItems")
}


model Transaction {
  id                String             @id @default(uuid())
  type              TransactionType
  amount            Decimal            @db.Decimal(10, 2)
  description       String?
  date              DateTime
  category          String
  receiptUrl        String?
  isRecurring       Boolean
  recurringInterval RecurringInterval?
  nextRecurringDate DateTime?
  lastProcessed     DateTime?
  status            TransactionStatus  @default(COMPLETED)
  userId            String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("transactions")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum RecurringInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
}
